{
  "id": "./",
  "name": "Zero Caliber 2 Community Arena",
  "short_name": "ZC2 Arena",
  "description": "Premium unofficial Zero Caliber 2 community PWA for tournaments, rankings, player profiles and messages.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#080b0d",
  "theme_color": "#080b0d",
  "categories": [
    "games",
    "social",
    "sports"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "shortcuts": [
    {
      "name": "Tournaments",
      "short_name": "Tournaments",
      "url": "./?page=tournaments",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "url": "./?page=chat",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}